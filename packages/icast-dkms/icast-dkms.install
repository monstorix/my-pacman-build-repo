post_install() {
  local _ver="$1"

  if [ ! -d "/lib/modules/$(uname -r)/build" ]; then
    echo "==> Kernel headers for $(uname -r) are missing; install the matching"
    echo "    linux-*-headers package, then run: dkms autoinstall"
    return 0
  fi

  dkms add -m icast -v "${_ver}" 2>/dev/null || true
  dkms build -m icast -v "${_ver}"
  dkms install -m icast -v "${_ver}" --force
}

post_upgrade() {
  # Drop the previous DKMS version, then build the new one.
  dkms remove -m icast -v "$2" --all 2>/dev/null || true
  post_install "$1"
}

pre_remove() {
  dkms remove -m icast -v "$1" --all 2>/dev/null || true
}
