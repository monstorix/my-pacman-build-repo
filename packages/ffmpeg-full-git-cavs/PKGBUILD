# This package is the AUR ffmpeg-full-git build (FFmpeg master, not a tagged
# release) with the CAVS/AVS patch stack from mpv-iina-avs applied on top.
# Some ffmpeg-full features depend on libraries that only exist in the AUR
# (astc-encoder, decklink-sdk, flite1, lcevcdec, libklvanc, mpeghdec, openapv,
# opencv4, quirc, libaribcaption, shine, rockchip-mpp, svt-jpeg-xs,
# vo-amrwbenc, vvenc, xavs, xavs2, xevd, xeve).  They are disabled here so the
# package can be built unattended in CI; restore the matching depends,
# makedepends, patches and --enable-* flags from the AUR PKGBUILD (plus
# --enable-libastcenc and the astcenc/astcenc.h include symlink) if you build
# locally with those packages installed.
source=('git+https://github.com/ffmpeg/ffmpeg.git'
        'git+https://github.com/lensfun/lensfun.git'
        "https://github.com/ggml-org/whisper.cpp/archive/v${_whispercpp_ver}/whisper.cpp-${_whispercpp_ver}.tar.gz"
        "amf-headers-${_amf_ver}.tar.gz::https://github.com/GPUOpen-LibrariesAndSDKs/AMF/archive/refs/tags/v${_amf_ver}.tar.gz"
        '010-ffmpeg-add-svt-hevc.patch'
        "020-ffmpeg-add-svt-hevc-docs-g${_svt_hevc_ver:0:7}.patch"::"https://raw.githubusercontent.com/OpenVisualCloud/SVT-HEVC/${_svt_hevc_ver}/ffmpeg_plugin/0002-doc-Add-libsvt_hevc-encoder-docs.patch"
        '030-ffmpeg-add-svt-vp9.patch'
        '040-ffmpeg-add-av_stream_get_first_dts-for-chromium.patch'
        '050-ffmpeg-fix-cuda-nvcc-with-gcc14.patch'
        '060-ffmpeg-lensfun-fix-pkgconfig.patch'
        '070-ffmpeg-whisper.cpp-fix-pkgconfig.patch'
        '0001-libcavs-add-avs-avsplus-dra-base.patch'
        '0002-libdavs2-export-sequence-display-color-metadata.patch'
        '0003-libarcdav3a-add-av3a-audio-vivid-decoder.patch'
        '0004-av3a-container-parser-demux.patch'
        '0005-av3a-content-probing.patch'
        '0006-av3a-stream-metadata.patch'
        '0007-libdavs2-reset-reference-state-on-seek.patch'
        '0008-libcavs-propagate-output-picture-field-metadata.patch'
        'LICENSE')
